---
import ExperienceItem from './ExperienceItem.astro'

const EXPERIENCE = [
  {
    date: "June 2026-Currently",
    title: "Software Engineering Intern",
    logo : "./jobs/Oracle.png",
    company : 'Oracle',
    description: "Working on the Semantic Modeler as part of the Oracle Analytics Cloud (OAC) team.",
    link: "https://docs.oracle.com/en/cloud/paas/analytics-cloud/acmdg/what-is-oracle-analytics-semantic-modeler.html",
  },
];

---


<ol class="relative border-s border-gray-200 dark:border-gray-700 mx-3.5">

    {
        EXPERIENCE.map( exp => (
            <li class="mb-10 ms-4">
                <ExperienceItem {...exp}/>
            </li>
        ))
    }

</ol>