---

import React from '../icons/React.astro'
import Javascript from '../icons/Javascript.astro';
import Html from '../icons/Html.astro';
import Css from '../icons/Css.astro';
import Tailwind from '../icons/Tailwind.astro';
import Github from '../icons/Github.astro';
import LinkButton from '../common/LinkButton.astro';
import Url from '../icons/Url.astro';
import Node from '../icons/Node.astro';
import Express from '../icons/Express.astro';
import MongoDB from '../icons/MongoDB.astro';
import TypeScript from '../icons/TypeScript.astro';
import Threejs from '../icons/Threejs.astro';



const TAGS = {
    NODE: { name: 'Node.js', icon: Node },
    EXPRESS: { name: 'Express', icon: Express },
    MONGODB: { name: 'MongoDB', icon: MongoDB },
    TYPESCRIPT: { name: 'TypeScript', icon: TypeScript },
    THREEJS: { name: 'Three.js', icon: Threejs },
    REACT : {
        name : 'React',
        class : 'text-white bg-[#1E3A8A]/80',
        icon : React
    },
    JAVASCRIPT : {
        name : 'Javascript',
        class : 'text-white bg-[#B45309]/80',
        icon : Javascript
    },
    HTML : {
        name : 'HTML',
        class : 'text-white bg-[#9B2C2C]/80',
        icon : Html
    },
    CSS : {
        name : 'CSS',
        class : 'text-white bg-[#2B6CB0]/80',
        icon : Css
    },
    TAILWIND : {
        name : 'Tailwind',
        class : 'text-white bg-[#1A5E5E]/80',
        icon : Tailwind
    }
}


const PROJECTS = [
  {
        title: "FinTrack",
        description: "A financial management application with authenticated access, category-based budgets, and transaction search and filtering. Built Express endpoints connected to MongoDB with bcrypt password hashing and JWT validation, budget CRUD with input checks, and user-scoped queries with pagination and debounced search.",
        link: undefined,
        github: 'https://github.com/mr-Mariano/fintrack',
        image: undefined,
        tags: [TAGS.NODE, TAGS.EXPRESS, TAGS.MONGODB, TAGS.JAVASCRIPT],
  },
  {
        title: "Eden Tree – Mars Habitat Configurator",
        description: "A collaborative Mars habitat prototype recognized as one of three winning teams among 32 at NASA Space Apps Guadalajara 2025. Integrated the team’s 3D model into React through AI-assisted development and connected Three.js mesh selection to React state in TypeScript, enabling selectable zones with assignable functional areas.",
        link: 'https://eden-tree-planner.lovable.app/',
        github: 'https://github.com/mr-Mariano/eden-tree-habitat',
        image: '/Eden.png',
        tags: [TAGS.REACT, TAGS.TYPESCRIPT, TAGS.THREEJS],
  },
  {
        title: "Movie Search App",
        description: "🎥  A movie search application that allows users to search for movies using The Movie Database (TMDB) API and displays trending movies using data stored in Appwrite.",
        link: "https://moviesbangsearch.netlify.app",
        github : 'https://github.com/mr-Mariano/Movie-Search',
        image :'./MovieSearch.png',
        tags: [TAGS.REACT, TAGS.JAVASCRIPT, TAGS.CSS, TAGS.HTML, TAGS.TAILWIND],
  },
  {
        title: "Discretion Toolkit",
        description: "An interactive toolkit for solving problems in logic and discrete structures, featuring tools for set theory, graph visualization, and logical equivalences.",
        link: "https://discretion.netlify.app/",
        github: "https://github.com/mr-Mariano/ToolKit-Discretion/tree/main",
        image: "./Discretion.png",
        tags: [TAGS.REACT, TAGS.JAVASCRIPT, TAGS.TAILWIND]
  },
];

---

    {
        PROJECTS.map( ({ title, description, link, github, image, tags })  => (
            <article class="flex flex-col py-[16px] px-[12px] md:gap-x-6 md:flex md:flex-row mb-18 align-center justify-center
            ">
                <div class:list={["order-2 md:order-2", image ? "md:w-1/2" : "w-full"]}>
                <h3
                    class = 'text-lg  md:text-2xl font-bold mb-4'>
                    { title }
                </h3>
                <ul class = 'computer-text flex flex-row flex-wrap gap-x-2 gap-y-2 mb-4'>
                    {
                        tags.map(tag => (
                            <li>
                                <span class="
                                    text-[#404040] dark:text-[#D4D4D4]
                                    bg-[#E5E5E580] dark:bg-[#26262699]
                                    flex gap-x-2 rounded-md
                                    items-center
                                    px-[8px] py-[4px]
                                    w-.9  md:w-full
                                    text-xs sm:text-sm font-medium
                                    ">
                                    <tag.icon class="size-4"/>
                                    {tag.name}
                                </span>
                            </li>
                        ))
                    }
                </ul>
                <p class = ' mb-4 text-pretty'>
                    { description }
                </p>
                <div class = 'flex flex-row gap-x-2 mb-4'>
                {
                    github && (
                        <LinkButton link={ github }>
                            Github
                            <Github class="w-3 h-3 ms-2 rtl:rotate-180" />
                        </LinkButton>
                    )
                }
                {
                    link && (
                        <LinkButton link={ link }>
                            View Project
                            <Url class="w-3 h-3 ms-2 rtl:rotate-180" />
                        </LinkButton>
                    )
                }
                </div>
                </div>
                {image && <div class="flex order-1 md:order-1 md:w-1/2 overflow-hidden border-neutral-50 hover:border-white rounded-lg pb-4">
                    <img
                        class = 'rounded shadow-white/10 shadow-2xl 
                        w-full h-1/2 md:size-full lg:w-full lg:h-full 
                        object-cover hover:scale-95 transform transition-transform duration-500'
                        src={image}
                        alt={`captura de pantalla del proyecto ${title}`}/>
                </div>}
            </article>
        ))
    }

 
